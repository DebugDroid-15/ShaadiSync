# ShaadiSync — Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local or sensitive secrets to version control.

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public API (Required from Phase 2 onward)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Secret Key (Required from Phase 2 onward - NEVER expose on client!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

